# Docker / production mode requires a login password. Replace this example
# with a long, unique password before publishing the site.
APP_USERNAME=xauwhale
APP_PASSWORD=

# Recommended: MarketData.app token. With OPRA entitlement this supplies
# low-latency GLD option Bid/Ask, IV and live Greeks plus SmartMid GLD spot.
MARKETDATA_TOKEN=

# Optional secondary source. A production Tradier token supplies real-time
# GLD quotes; Tradier documents ORATS Greeks as hourly. Without either token,
# GLD options use the editable Black-Scholes fallback and the site still works.
TRADIER_API_TOKEN=

# Optional Tradier sandbox URL for delayed test data:
# TRADIER_BASE_URL=https://sandbox.tradier.com/v1

# Optional server settings
PORT=3000
# DATA_FILE=./data/portfolio.json
