# Application login accounts. Passwords must be supplied as private environment
# variables in Docker / Render; do not commit real passwords to this file.
APP_USERNAME=xauadmin
APP_PASSWORD=
VIEWER_USERNAME=xauwhales
VIEWER_PASSWORD=

# Public URL path used by the reverse proxy. Keep / for a root-domain deploy;
# use /optionhedger/ for https://example.com/optionhedger/.
VITE_BASE_PATH=/

# Recommended: MarketData.app token. With OPRA entitlement this supplies
# low-latency GLD option Bid/Ask, IV and live Greeks plus SmartMid GLD spot.
MARKETDATA_TOKEN=

# Optional secondary source. A production Tradier token supplies real-time
# GLD quotes; Tradier documents ORATS Greeks as hourly. Without either token,
# GLD options use the editable Black-Scholes fallback and the site still works.
TRADIER_API_TOKEN=

# 6Smain (CME Swiss Franc futures options). Preferred cloud integration:
# Databento CME Globex GLBX.MDP3. The server queries 6S.OPT definitions/book
# data and each option's actual underlying future as the IV reference;
# 6S.c.0 is only the displayed main future. Credentials never reach the
# browser. CME/Databento market-data entitlements may be required.
DATABENTO_API_KEY=
# SIX_S_DATABENTO_LOOKBACK_MINUTES=10
# SIX_S_DATABENTO_PARENT_SYMBOLS=CHU.OPT,1SF.OPT,2SF.OPT,3SF.OPT,4SF.OPT,5SF.OPT
# No credentials: CME public delayed/reference monthly + Friday weekly chains
# are enabled automatically. Missing Bid/Ask/depth remain missing.

# Optional enterprise/company snapshot gateway. When present it takes priority
# over Databento. It should return { spot, timestamp, source, quotes: [...] }.
# SIX_S_OPTION_CHAIN_URL=https://market-gateway.example.com/6s/options
# SIX_S_OPTION_CHAIN_TOKEN=

# Optional Tradier sandbox URL for delayed test data:
# TRADIER_BASE_URL=https://sandbox.tradier.com/v1

# Optional server settings
PORT=3000
# DATA_FILE=./data/portfolio.json
